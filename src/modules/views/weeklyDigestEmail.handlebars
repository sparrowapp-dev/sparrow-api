<!DOCTYPE html>
<html>
<body style="margin:0; padding:0; background:#eef2f7;">

<table width="100%" cellpadding="0" cellspacing="0" bgcolor="#eef2f7">
  <tr>
    <td align="center">

      <!-- Main Container -->
      <table width="560" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="border-radius:12px; padding:30px; font-family:Arial, sans-serif;">

        <!-- Heading -->
        <tr>
          <td style="font-size:20px; font-weight:600; color:#1f2937; padding-bottom:8px;">
            Hey {{userName}}, how did your APIs behave this week?
          </td>
        </tr>

        <!-- Title -->
        <tr>
          <td style="font-size:16px; font-weight:600; color:#3b82f6; padding-bottom:20px;">
            Sparrow – Weekly Digest
          </td>
        </tr>

        {{!-- Date --}}
        <tr>
          <td style="font-size:12px;color:#6B7280;padding-bottom:20px;">
            {{dateRange}}
          </td>
        </tr>

        <!-- Execution Card -->
        <tr>
          <td bgcolor="#f4f6fb" style="padding:16px;border-radius:10px;">

            <table width="100%">
              <tr>
                <!-- LEFT SIDE -->
                <td width="50%" valign="middle">

                  <div style="font-size:13px;color:#6B7280;">
                    Execution trend
                  </div>

                  <div style="font-size:28px;font-weight:700;color:#111827;margin-top:4px;">
                    {{execution.total}}
                  </div>

                  <div style="font-size:12px;color:#16A34A;margin-top:4px;">
                    ↑ {{execution.percent}}% from last week
                  </div>

                </td>

                <!-- RIGHT SIDE GRAPH -->
                <td width="50%" valign="bottom">

                                  <table width="100%" height="60">
                                    <tr valign="bottom" align="center">

                                      {{#each execution.graph}}
                <td>
                  <div style="width:6px;
                              height:{{this.height}}px; 
                              background:{{#if this.isMax}}#6366F1{{else}}#c7d2fe{{/if}};
                              border-radius:2px;
                              margin:auto;">
                  </div>
                </td>
                {{/each}}

                    </tr>

                    <!-- DAYS -->
                    <tr align="center">
                      <td style="font-size:10px;color:#9CA3AF;">M</td>
                      <td style="font-size:10px;color:#9CA3AF;">T</td>
                      <td style="font-size:10px;color:#9CA3AF;">W</td>
                      <td style="font-size:10px;color:#9CA3AF;">T</td>
                      <td style="font-size:10px;color:#9CA3AF;">F</td>
                      <td style="font-size:10px;color:#9CA3AF;">S</td>
                      <td style="font-size:10px;color:#9CA3AF;">S</td>
                    </tr>

                  </table>

                </td>
              </tr>
            </table>

          </td>
        </tr>

        <!-- Spacing -->
        <tr><td height="20"></td></tr>

        <!-- Highlights Card -->
        <tr>
          <td bgcolor="#f4f6fb" style="padding:16px;border-radius:10px;">

            <div style="font-size:14px;font-weight:600;color:#111827;margin-bottom:12px;">
              Additional highlights
            </div>

            <table width="100%">
              <tr align="center">

                <!-- ITEM -->
                {{!-- Repeat this block --}}
                <td width="20%" style="padding:6px;">
                  
                  <div style="width:26px;height:26px;margin:auto;background:#FCE7F3;border-radius:6px;line-height:26px;font-size:13px;">
                    📡
                  </div>

                  <div style="font-size:17px;font-weight:700;color:#2563EB;margin-top:6px;">
                    {{metrics.apisCreated}}
                  </div>

                  <div style="font-size:11px;color:#6B7280;margin-top:2px;">
                    API's created
                  </div>

                </td>

                <!-- COPY for others -->
                
                <td width="20%" style="padding:6px;">
                  <div style="width:26px;height:26px;margin:auto;background:#EEF2FF;border-radius:6px;line-height:26px;font-size:13px;">
                    ⚡
                  </div>
                  <div style="font-size:17px;font-weight:700;color:#2563EB;margin-top:6px;">
                    {{metrics.testflowsExecuted}}
                  </div>
                  <div style="font-size:11px;color:#6B7280;margin-top:2px;">
                    Test Flows Executed
                  </div>
                </td>

                <td width="20%" style="padding:6px;">
                  <div style="width:26px;height:26px;margin:auto;background:#FEF9C3;border-radius:6px;line-height:26px;font-size:13px;">
                    👤
                  </div>
                  <div style="font-size:17px;font-weight:700;color:#2563EB;margin-top:6px;">
                    {{metrics.activeWorkspaces}}
                  </div>
                  <div style="font-size:11px;color:#6B7280;margin-top:2px;">
                    Active Workspaces
                  </div>
                </td>

                <td width="20%" style="padding:6px;">
                  <div style="width:26px;height:26px;margin:auto;background:#FEF9C3;border-radius:6px;line-height:26px;font-size:13px;">
                    📁
                  </div>
                  <div style="font-size:17px;font-weight:700;color:#2563EB;margin-top:6px;">
                    {{metrics.newCollections}}
                  </div>
                  <div style="font-size:11px;color:#6B7280;margin-top:2px;">
                    New Collections
                  </div>
                </td>

                <td width="20%" style="padding:6px;">
                  <div style="width:26px;height:26px;margin:auto;background:#DCFCE7;border-radius:6px;line-height:26px;font-size:13px;">
                    ➕
                  </div>
                  <div style="font-size:17px;font-weight:700;color:#2563EB;margin-top:6px;">
                    {{metrics.newWorkspaces}}
                  </div>
                  <div style="font-size:11px;color:#6B7280;margin-top:2px;">
                    New Workspace
                  </div>
                </td>

              </tr>
            </table>

          </td>
        </tr>

        <tr><td height="12"></td></tr>

        {{!-- Collaboration Updates --}}

        {{#if collaborationUpdates.length}}
          <tr>
            <td bgcolor="#f4f6fb" style="padding:16px;border-radius:10px;border-left:3px solid #3b82f6;">
              
              <div style="font-size:14px;font-weight:600;color:#111827;margin-bottom:10px;">
                Collaboration Updates
              </div>

              <ul style="padding-left:16px;margin:0;color:#374151;font-size:13px;">
                {{#each collaborationUpdates}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>

            </td>
          </tr>

          <tr><td height="12"></td></tr>
        {{/if}}

        <tr><td height="12"></td></tr>

        {{!-- Pending Actions --}}

        {{#if pendingActions.length}}
          <tr>
            <td bgcolor="#f4f6fb" style="padding:16px;border-radius:10px;border-left:3px solid #3b82f6;">
              
              <div style="font-size:14px;font-weight:600;color:#111827;margin-bottom:10px;">
                Pending Actions
              </div>

              <ul style="padding-left:16px;margin:0;color:#374151;font-size:13px;">
                {{#each pendingActions}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>

            </td>
          </tr>

          <tr><td height="12"></td></tr>
        {{/if}}     

        <tr><td height="12"></td></tr> 

        <!-- Button -->
       

        <tr>
          <td style="padding:20px 16px; text-align:center;">

            <div style="font-size:13px;color:#6B7280;">
              Continue in <span style="color:#2563EB;">Sparrow..</span>
            </div>

            <div style="margin-top:10px;">
              <a href="{{ctaLink}}"
                style="background:#2563EB;color:white;padding:10px 20px;border-radius:6px;text-decoration:none;font-size:13px;">
                Open Sparrow
              </a>
            </div>

          </td>
        </tr>

<tr>
  <td style="padding:0 16px 20px 16px; text-align:left;">

    <div style="font-size:11px;color:#9CA3AF;">
      You're receiving this email because you're part of an active Sparrow workspace.
    </div>

    <div style="margin-top:6px;">
      <a href="#" style="font-size:11px;color:#2563EB;text-decoration:none;">
        Unsubscribe
      </a>
    </div>

  </td>
</tr>

{{> footer}}

      </table>

    </td>
  </tr>
</table>

</body>
</html>