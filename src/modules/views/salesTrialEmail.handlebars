{{!< layoutName}} <!DOCTYPE html>
    <html lang="en">

  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Trial Email</title>


      <style>
          body {
              font-family: "Inter", sans-serif;
              box-sizing: border-box;
              padding: 0;
              margin: 0;
              transition: background-color 0.3s, color 0.3s;
          }

          .container {
              display: flex;
              justify-content: center;
              width: 100%;
              height: 100%;

          }

          .container-data {
              margin: auto;
              max-width: 570px;
              padding: 20px;
              transition: background-color 0.3s, color 0.3s;
          }

          .email-text-style {
              color: var(--email-text-color, #333);
              font-family: "Inter", sans-serif;
              font-size: 16px;
              font-style: normal;
              font-weight: 400;
              line-height: 21px;
          }
      </style>
  </head>

  <body>
      <div class="container">
          <section style="width: 100%;">
              <div class="container-data">

                  {{> headerV2}}
                  <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                      <tr>
                          <td align="center" valign="top">
                              <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                  <tr>
                                      <td align="center" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-headerv2.png" bgcolor="#4A90E2" style="background-position: center; background-repeat: no-repeat; background-size: cover;">
                                          <div style="padding: 40px 30px;">
                                              <h1 style="font-size: 28px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">Welcome to Sparrow, {{userName}}!</h1>
                                              <p style="font-size: 16px; font-weight: 400; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif;">Your {{trialPeriod}}-month trial is just a step away</p>
                                          </div>
                                      </td>
                                  </tr>
                              </table>
                          </td>
                      </tr>
                  </table>
                  <section>

                      <!-- Welcome Box -->
                      <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                          <tr>
                              <td>
                                  <div class="email-text-style">
                                      <p>
                                          Hi {{userName}},
                                      </p>
                                      <p>
                                          We're so excited to welcome you to Sparrow! As part of our special offer, you now have access to a 2-month free trial of the Standard Plan — no charges until your trial ends.
                                      </p>
                                      <p>
                                          To make things simple, we've already created your account using this email: <br> <span style="font-weight: 600;">{{userEmail}}</span>
                                      </p>
                                      <p>
                                          All you need to do is set your password and follow a few quick steps to activate your trial and unlock everything Sparrow has to offer.
                                      </p>
                                  </div>
                              </td>
                          </tr>
                      </table>

                      <!-- What's included in your trial section -->
                      <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                          <tr>
                              <td align="center" valign="middle">
                                  <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                      <tr>
                                          <td align="left" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-middlev2.png" bgcolor="#3B4B6B" style="background-position: center; background-repeat: no-repeat; background-size: cover; border-radius: 8px;">
                                              <div style="padding: 30px 35px;">
                                                  <!-- Section Title -->
                                                  <h2 style="font-size: 22px; font-weight: 600; color: #ffffff; margin: 0 0 25px 0; line-height: 1.3; font-family: 'Inter', Arial, sans-serif;">
                                                      What's included in your trial?
                                                  </h2>

                                                  <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                                      <tr>
                                                          <td style="padding-bottom: 12px;">
                                                              <table cellspacing="0" cellpadding="0" border="0">
                                                                  <tr>
                                                                      <td style="width: 28px; vertical-align: top; padding-right: 15px;">
                                                                          <div style="width: 22px; height: 22px; background-color: #10B981; border-radius: 50%; display: flex; align-items: center; justify-content: center; line-height: 22px; text-align: center;">
                                                                              <span style="color: #ffffff; font-size: 14px; font-weight: bold; font-family: 'Inter', Arial, sans-serif;">✓</span>
                                                                          </div>
                                                                      </td>
                                                                      <td style="vertical-align: top;">
                                                                          <p style="font-size: 16px; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif; font-weight: 400;">
                                                                              Full access to Sparrow Standard features
                                                                          </p>
                                                                      </td>
                                                                  </tr>
                                                              </table>
                                                          </td>
                                                      </tr>
                                                      <tr>
                                                          <td style="padding-bottom: 12px;">
                                                              <table cellspacing="0" cellpadding="0" border="0">
                                                                  <tr>
                                                                      <td style="width: 28px; vertical-align: top; padding-right: 15px;">
                                                                          <div style="width: 22px; height: 22px; background-color: #10B981; border-radius: 50%; display: flex; align-items: center; justify-content: center; line-height: 22px; text-align: center;">
                                                                              <span style="color: #ffffff; font-size: 14px; font-weight: bold; font-family: 'Inter', Arial, sans-serif;">✓</span>
                                                                          </div>
                                                                      </td>
                                                                      <td style="vertical-align: top;">
                                                                          <p style="font-size: 16px; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif; font-weight: 400;">
                                                                              Up to {{inviteCount}} members in your hub
                                                                          </p>
                                                                      </td>
                                                                  </tr>
                                                              </table>
                                                          </td>
                                                      </tr>
                                                      <tr>
                                                          <td style="padding-bottom: 0;">
                                                              <table cellspacing="0" cellpadding="0" border="0">
                                                                  <tr>
                                                                      <td style="width: 28px; vertical-align: top; padding-right: 15px;">
                                                                          <div style="width: 22px; height: 22px; background-color: #10B981; border-radius: 50%; display: flex; align-items: center; justify-content: center; line-height: 22px; text-align: center;">
                                                                              <span style="color: #ffffff; font-size: 14px; font-weight: bold; font-family: 'Inter', Arial, sans-serif;">✓</span>
                                                                          </div>
                                                                      </td>
                                                                      <td style="vertical-align: top;">
                                                                          <p style="font-size: 16px; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif; font-weight: 400;">
                                                                              Priority support and collaboration tools
                                                                          </p>
                                                                      </td>
                                                                  </tr>
                                                              </table>
                                                          </td>
                                                      </tr>
                                                  </table>

                                              </div>
                                          </td>
                                      </tr>
                                  </table>
                              </td>
                          </tr>
                      </table>
                      <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                          <tr>
                              <td>

                                  <div class="email-text-style" style="margin-bottom: 15px;">
                                      <p>
                                          Here's what to do next:
                                      </p>
                                      <p style=" margin-top: ; margin-bottom: 4px;" ]>
                                          1. Click the button below to get started
                                      </p>

                                      <p style="margin-top: 0; margin-bottom: 4px;">
                                          2. Personalize your hub name
                                      </p>

                                      <p style="margin-top: 0; margin-bottom: 4px;">
                                          3. Enter your card details (Don't worry — you won't be charged until the trial ends!)
                                      </p>

                                      <p style="margin-top: 0; margin-bottom: 4px;">
                                          4. Invite your teammates and start collaborating!
                                      </p>
                                  </div>

                                  <p class="email-text-style">
                                      No secure code needed, no extra steps. You're already logged in securely through this email.
                                  </p>


                                  <div>
                                      <table cellspacing="0" cellpadding="0" border="0">
                                          <tr>
                                              <td style="border-radius: 6px; background-color: #316CF6; padding: 6px 12px; min-height: 36px;">
                                                  <a href="{{startTrialUrl}}" class="email-text-style" style="display: inline-block; color: #ffffff; text-decoration: none;">
                                                      Start Standard Trial
                                                  </a>
                                              </td>
                                          </tr>
                                      </table>
                                  </div>
                                  <div class="email-text-style">
                                      <p>
                                          If you have any questions or need a quick walkthrough, we're here to help, reach out to us at
                                          <a href="mailto:contactus@sparrowapp.dev" style="color: #316CF6;">contactus@sparrowapp.dev</a>
                                      </p>

                                      <p>
                                          We're so glad you're here — let's build something amazing together.
                                      </p>

                                      <p>
                                          Happy exploring,<br>
                                          The Sparrow Team
                                      </p>
                                  </div>
                              </td>
                          </tr>
                      </table>


                  </section>


                  {{> footerV2}}


              </div>
          </section>
      </div>
  </body>

  </html>