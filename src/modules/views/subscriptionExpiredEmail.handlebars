{{!< layoutName}} <!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscription Expired</title>

    <style>
        body {
            font-family: "Inter", sans-serif;
            box-sizing: border-box;
            padding: 0;
            margin: 0;
            transition: background-color 0.3s, color 0.3s;
        }

        .container {
            display: flex;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .container-data {
            margin: auto;
            max-width: 570px;
            padding: 20px;
            transition: background-color 0.3s, color 0.3s;
        }

        .email-text-style {
            color: var(--email-text-color, #333);
            font-family: "Inter", sans-serif;
            font-size: 16px;
            font-style: normal;
            font-weight: 400;
            line-height: 21px;
        }
    </style>
</head>

<body>
    <div class="container">
        <section style="width: 100%;">
            <div class="container-data">

                {{> headerV2}}
                
                <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                    <tr>
                        <td align="center" valign="top">
                            <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td align="center" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-headerv2.png" bgcolor="#4A90E2" style="background-position: center; background-repeat: no-repeat; background-size: cover;">
                                        <div style="padding: 40px 30px;">
                                            <h1 style="font-size: 28px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">Your Sparrow subscription has expired</h1>
                                            <p style="font-size: 16px; font-weight: 400; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif;">Take action within 3 days</p>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <section>
                    <!-- Message content -->
                    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                        <tr>
                            <td>
                                <div class="email-text-style">
                                    <p>
                                        Hi {{firstName}}, 👋
                                    </p>
                                    <p>
                                        Your current plan for the Sparrow {{planName}} Plan has ended today.
                                    </p>
                                    <p>
                                        Please make the payment to your current subscription plan by heading to the billing section, to continue enjoying premium features without interruption.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Action button -->
                    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                        <tr>
                            <td>
                                <div style="margin: 20px 0;">
                                    <table cellspacing="0" cellpadding="0" border="0">
                                        <tr>
                                            <td style="border-radius: 6px; background-color: #316CF6; padding: 12px 24px; min-height: 36px;">
                                                <a href="{{billingUrl}}" class="email-text-style" style="display: inline-block; color: #ffffff; text-decoration: none; font-weight: 600;">
                                                    Go to Billing
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div class="email-text-style">
                                    <p>
                                        We would be providing a grace period of 3 days in order to complete your payment. If no action is taken during the grace period, your hub will be downgraded to the free Community Plan.
                                    </p>
                                    <p>
                                        If you have any questions or need a quick walkthrough, we're here to help, reach out to us at
                                        <a href="mailto:{{sparrowEmail}}" style="color: #316CF6;">{{sparrowEmail}}</a>
                                    </p>
                                    <p>
                                        Warm Regards,<br>
                                        The Sparrow Team
                                    </p>
                                </div>
                            </td>
                        </tr>
                    </table>
                </section>

                {{> footerV2}}

            </div>
        </section>
    </div>
</body>

</html>
