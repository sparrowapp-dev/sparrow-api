<!-- Sparrow Email Header Component -->
<table
  width="100%"
  cellspacing="0"
  cellpadding="0"
  border="0"
  style="border-top-left-radius: 8px; border-top-right-radius: 8px; background-color: transparent;"
>
  <tr>
    <td align="center" style="padding: 15px 0;">
      <table cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td style="vertical-align: middle;">
            <img
              src="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-logo.png"
              alt="Sparrow Logo"
              width="24"
              height="24"
              style="display: inline-block; vertical-align: middle;"
            />
          </td>
          <td style="padding-left: 8px; vertical-align: middle;">
            <span
              style="font-size: 18px; font-weight: 600; color: var(--header-text-color, #ffffff); font-family: 'Inter', Arial, sans-serif;"
            >Sparrow</span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>