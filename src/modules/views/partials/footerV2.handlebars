<!-- Sparrow Email Footer Component -->
<table
  width="100%"
  cellspacing="0"
  cellpadding="0"
  border="0"
  style="border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"
>
  <tr>
    <td align="center" style="padding: 20px 30px;">
      <table cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td align="center">
            <table cellspacing="0" cellpadding="0" border="0">
              <tr>
                <td style="vertical-align: middle;">
                  <img
                    src="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-logo.png"
                    alt="Sparrow Logo"
                    width="20"
                    height="20"
                    style="display: inline-block; vertical-align: middle;"
                  />
                </td>
                <td style="padding-left: 8px; vertical-align: middle;">
                  <span
                    style="font-size: 18px; font-weight: 600; color: var(--email-text-color, #333); font-family: 'Inter', Arial, sans-serif;"
                  >Sparrow</span>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding-top: 12px;">
            <p
              style="font-size: 12px; color: #888888; margin: 0; font-family: 'Inter', Arial, sans-serif;"
            >&copy; Sparrow 2025 | Made with ❤️ by Techdome</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>