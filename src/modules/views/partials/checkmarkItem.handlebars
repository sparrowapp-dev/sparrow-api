<tr>
  <td style="padding-bottom: 12px;">
    <table cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td style="width: 28px; vertical-align: top; padding-right: 4px;">
          <div
            style="width: 22px; height: 22px; background-color: #10B981; border-radius: 50%; text-align: center; line-height: 22px;"
          >
            <span
              style="color: #ffffff; font-size: 14px; font-weight: bold; font-family: 'Inter', Arial, sans-serif;"
            >✓</span>
          </div>
        </td>
        <td style="vertical-align: top;">
          <p
            style="font-size: 16px; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif; font-weight: 400;"
          >
            {{text}}
          </p>
        </td>
      </tr>
    </table>
  </td>
</tr>