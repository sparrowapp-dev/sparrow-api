{{!< layoutName}} <!DOCTYPE html>
    <html lang="en">

  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Team Invite Registered Email</title>

      <style>
          body {
              font-family: "Inter", sans-serif;
              box-sizing: border-box;
              padding: 0;
              margin: 0;
              transition: background-color 0.3s, color 0.3s;
          }

          .container {
              display: flex;
              justify-content: center;
              width: 100%;
              height: 100%;

          }

          .container-data {
              margin: auto;
              max-width: 570px;
              padding: 20px;
              transition: background-color 0.3s, color 0.3s;
          }

          .email-text-style {
              color: var(--email-text-color, #333);
              font-family: "Inter", sans-serif;
              font-size: 16px;
              font-style: normal;
              font-weight: 400;
              line-height: 21px;
          }
      </style>
  </head>

    <body>
     <div class="container">
         <section style="width: 100%;">
             <div class="container-data">

                 {{> headerV2}}
                 <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                     <tr>
                         <td align="center" valign="top">
                             <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                 <tr>
                                     <td align="center" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-headerv2.png" bgcolor="#4A90E2" style="background-position: center; background-repeat: no-repeat; background-size: cover;">
                                         <div style="padding: 40px 30px;">
                                             <h1 style="font-size: 28px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">You’ve been invited to join Techdome Hub on Sparrow</h1>
                                         </div>
                                     </td>
                                 </tr>
                             </table>
                         </td>
                     </tr>
                 </table>
                 <section>
                     <!-- Welcome Box -->
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                         <tr>
                             <td>
                                 <div class="email-text-style">
                                     <p>
                                         Hi {{userName}}, 👋
                                     </p>
                                     <p>
                                        Welcome to Sparrow! You’ve been invited to join the hub <span style="font-weight: 700; word-break: break-all;">“{{teamName}} Hub”</span> as an <span style="color:font-weight: 700;">“{{role}}”</span>.
                                     </p>
                                     <p>
                                        This trial gives you access to all the features of our Standard plan so you can explore, test, and see how Sparrow fits into your workflow, with no limitations.
                                     </p>
                                 </div>
                             </td>
                         </tr>
                     </table>
                     <!-- What's included in your trial section -->
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                         <tr>
                             <td align="center" valign="middle">
                                 <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                     <tr>
                                         <td align="left" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-middlev2.png" bgcolor="#3B4B6B" style="background-position: center; background-repeat: no-repeat; background-size: cover; border-radius: 8px;">
                                             <div style="padding: 20px 12px;">
                                                 <!-- Section Title -->
                                                 <h2 style="font-size: 22px; font-weight: 600; color: #ffffff; margin: 0 0 4px 0; line-height: 1.3; font-family: 'Inter', Arial, sans-serif;">
                                                     What’s Next?
                                                 </h2>
                                                 <p style="font-size: 16px; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif; font-weight: 400;">Click below to accept your invite and set up your Sparrow account:</p>
                                                 <div>
                                                     <table cellspacing="0" cellpadding="0" border="0">
                                                         <tr>
                                                             <td style="border-radius: 6px; background-color: #316CF6; padding: 6px 12px; min-height: 36px;">
                                                                 <a href="{{authUrl}}/accept-team-invite/{{teamId}}/{{inviteId}}/{{email}}" class="email-text-style" style="display: inline-block; color: #ffffff; text-decoration: none;">
                                                                     Accept Invite
                                                                 </a>
                                                             </td>
                                                         </tr>
                                                     </table>
                                                 </div>
                                             </div>
                                         </td>
                                     </tr>
                                 </table>
                             </td>
                         </tr>
                     </table>
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                         <tr>
                             <td>
                                 <div class="email-text-style">
                                     <p>
                                         We’re excited to have you onboard. If you need help or have questions, our team is just a message away, reach out to us at
                                         <a href="mailto:contactus@sparrowapp.dev" style="color: #316CF6;">contactus@sparrowapp.dev</a>
                                     </p>

                                     <p>
                                         Warm Regards,<br>
                                         The Sparrow Team
                                     </p>
                                 </div>
                             </td>
                         </tr>
                     </table>


                 </section>


                 {{> footerV2}}


             </div>
         </section>
     </div>
  </body>

</html>