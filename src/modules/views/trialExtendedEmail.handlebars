{{!< layoutName}} <!DOCTYPE html>
    <html lang="en">

  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Trial Email</title>


      <style>
          body {
              font-family: "Inter", sans-serif;
              box-sizing: border-box;
              padding: 0;
              margin: 0;
              transition: background-color 0.3s, color 0.3s;
          }

          .container {
              display: flex;
              justify-content: center;
              width: 100%;
              height: 100%;

          }

          .container-data {
              margin: auto;
              max-width: 570px;
              padding: 20px;
              transition: background-color 0.3s, color 0.3s;
          }

          .email-text-style {
              color: var(--email-text-color, #333);
              font-family: "Inter", sans-serif;
              font-size: 16px;
              font-style: normal;
              font-weight: 400;
              line-height: 21px;
          }
      </style>
  </head>

    <body>
     <div class="container">
         <section style="width: 100%;">
             <div class="container-data">

                 {{> headerV2}}
                 <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                     <tr>
                         <td align="center" valign="top">
                             <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                 <tr>
                                     <td align="center" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-headerv2.png" bgcolor="#4A90E2" style="background-position: center; background-repeat: no-repeat; background-size: cover;">
                                         <div style="padding: 40px 30px;">
                                            <h1 style="font-size: 28px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">
                                            Your Sparrow Trial Has Been Extended
                                            </h1>                                         
                                         </div>
                                     </td>
                                 </tr>
                             </table>
                         </td>
                     </tr>
                 </table>
                 <section>
                     <!-- Welcome Box -->
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                         <tr>
                             <td>
                                 <div class="email-text-style">
                                     <p>
                                         Hi 👋
                                     </p>
                                    <p>
                                    Great news! Your Sparrow trial for the hub “{{hubName}}” has been successfully extended. 🎉
                                    </p>

                                    <p>
                                    You now have additional time to explore Sparrow’s powerful collaboration features and continue working with your team without interruption.
                                    </p>
                                    <p>
                                    Your new trial end date is <strong>{{billingPeriodEnd}}</strong>.
                                    Enjoy the extended access and make the most of Sparrow!
                                    </p>
                                 </div>
                             </td>
                         </tr>
                     </table>
                     <table style="margin-bottom: 20px;" class="email-text-style" width="100%" cellpadding="0" cellspacing="0" border="0">
                         <tr>
                             <td style="border-bottom:1px solid #b0b8c1" colspan="2">
                                 <h1 style="margin-top:0; margin-bottom: -6px;">Trial Details</h1>
                             </td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Hub Name</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">{{hubName}}</td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Trial Start</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">{{trialStart}}</td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Trial End</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">{{trialEnd}}</td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Amount After Trial</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">{{amount}}</td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Team Members</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">
                                 {{userCount}}
                             </td>
                         </tr>
                     </table>

                     <!-- What's included in your trial section -->
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                         <tr>
                             <td align="center" valign="middle">
                                 <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                     <tr>
                                         <td align="left" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-middlev2.png" bgcolor="#3B4B6B" style="background-position: center; background-repeat: no-repeat; background-size: cover; border-radius: 8px;">
                                             <div style="padding: 20px 12px;">
                                                 <!-- Section Title -->
                                                 <h2 style="font-size: 22px; font-weight: 600; color: #ffffff; margin: 0 0 4px 0; line-height: 1.3; font-family: 'Inter', Arial, sans-serif;">
                                                     What’s Next?
                                                 </h2>
                                                 <p style="font-size: 16px; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif; font-weight: 400; margin-bottom: 14px;">Click the button below to navigate to your hub and start exploring:</p>
                                                 <div>
                                                     <table cellspacing="0" cellpadding="0" border="0">
                                                         <tr>
                                                             <td style="border-radius: 6px; background-color: #316CF6; padding: 6px 12px; min-height: 36px;">
                                                                 <a href="{{hubUrl}}" class="email-text-style" style="display: inline-block; color: #ffffff; text-decoration: none;">
                                                                     Go to My Hub
                                                                 </a>
                                                             </td>
                                                         </tr>
                                                     </table>
                                                 </div>
                                             </div>
                                         </td>
                                     </tr>
                                 </table>
                             </td>
                         </tr>
                     </table>
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                         <tr>
                             <td>
                                 <div class="email-text-style">
                                     <p>
                                         You can always invite more team members anytime from your hub dashboard. If you have any questions or need a quick walkthrough, we’re here to help, reach out to us a
                                         <a href="mailto:contactus@sparrowapp.dev" style="color: #316CF6;">contactus@sparrowapp.dev</a>
                                     </p>

                                     <p>
                                         Thanks for trying Sparrow, we can’t wait to see how your team makes the most of it.Happy exploring,The Sparrow Team
                                     </p>

                                     <p>
                                         Happy exploring,<br>
                                         The Sparrow Team
                                     </p>
                                 </div>
                             </td>
                         </tr>
                     </table>


                 </section>


                 {{> footerV2}}


             </div>
         </section>
     </div>
  </body>

</html>