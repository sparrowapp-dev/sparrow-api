{{!< layoutName}} <!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Action Required - Payment</title>

    <style>
        body {
            font-family: "Inter", sans-serif;
            box-sizing: border-box;
            padding: 0;
            margin: 0;
            transition: background-color 0.3s, color 0.3s;
        }

        .container {
            display: flex;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .container-data {
            margin: auto;
            max-width: 570px;
            padding: 20px;
            transition: background-color 0.3s, color 0.3s;
        }

        .email-text-style {
            color: var(--email-text-color, #333);
            font-family: "Inter", sans-serif;
            font-size: 16px;
            font-style: normal;
            font-weight: 400;
            line-height: 21px;
        }
    </style>
</head>

<body>
    <div class="container">
        <section style="width: 100%;">
            <div class="container-data">

                {{> headerV2}}
                
                <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                    <tr>
                        <td align="center" valign="top">
                            <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td align="center" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-headerv2.png" bgcolor="#4A90E2" style="background-position: center; background-repeat: no-repeat; background-size: cover;">
                                        <div style="padding: 40px 30px;">
                                            <h1 style="font-size: 28px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">Action Required</h1>
                                            <p style="font-size: 16px; font-weight: 400; color: #ffffff; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif;">Your Sparrow plan will expire in {{ expireIn }} days</p>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <section>
                    <!-- Welcome message -->
                    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                        <tr>
                            <td>
                                <div class="email-text-style">
                                    <p>
                                        Hi {{firstName}}, 👋
                                    </p>
                                    <p>
                                        We wanted to give you a heads-up — your current plan on Sparrow is set to expire in {{ expireIn }} days.
                                    </p>
                                    <p>
                                        To avoid any disruptions, please review your billing settings and manage the users who will be billed in the next cycle.
                                    </p>
                                    <p>
                                        All invited users will count toward billing. You can update or remove them before your renewal date.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    </table>


                    <!-- Simplified Overview table -->
                    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="border-collapse: collapse; border: none; margin-bottom: 30px;">
                    <thead>
                        <tr>
                        <th colspan="2" align="left" style="padding: 14px 20px; font-size: 20px; font-family: 'Inter', Arial, sans-serif; background-color: #eee; color: #333; border-bottom: 1px solid #ccc;">
                            Overview
                        </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                        <td style="padding: 12px 20px; font-weight: 600; font-family: 'Inter', Arial, sans-serif; border-bottom: 1px solid #eee;">
                            Active Users
                        </td>
                        <td style="padding: 12px 20px; text-align: right; font-family: 'Inter', Arial, sans-serif; border-bottom: 1px solid #eee;">
                            {{usedSeats}} Users
                        </td>
                        </tr>
                        <tr>
                        <td style="padding: 12px 20px; font-weight: 600; font-family: 'Inter', Arial, sans-serif; border-bottom: 1px solid #eee;">
                            Invited Users
                        </td>
                        <td style="padding: 12px 20px; text-align: right; font-family: 'Inter', Arial, sans-serif; border-bottom: 1px solid #eee;">
                            {{totalSeats}} Users
                        </td>
                        </tr>
                        <tr>
                        <td style="padding: 12px 20px; font-weight: 600; font-family: 'Inter', Arial, sans-serif; border-bottom: 1px solid #eee;">
                            Total Billable Users
                        </td>
                        <td style="padding: 12px 20px; text-align: right; font-family: 'Inter', Arial, sans-serif; border-bottom: 1px solid #eee;">
                            {{totalSeats}} Users
                        </td>
                        </tr>
                        <tr>
                        <td style="padding: 12px 20px; font-weight: 600; font-family: 'Inter', Arial, sans-serif;">
                            Estimated Charges
                        </td>
                        <td style="padding: 12px 20px; text-align: right; font-family: 'Inter', Arial, sans-serif;">
                            ${{estimatedCharges}}/month
                        </td>
                        </tr>
                    </tbody>
                    </table>

                    <!-- Action section -->
                    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                        <tr>
                            <td>
                                <div class="email-text-style">
                                    <p>
                                        Click below to manage users:
                                    </p>
                                </div>

                                <div style="margin: 20px 0;">
                                    <table cellspacing="0" cellpadding="0" border="0">
                                        <tr>
                                            <td style="border-radius: 6px; background-color: #316CF6; padding: 12px 24px; min-height: 36px;">
                                                <a href="{{manageUsersUrl}}" class="email-text-style" style="display: inline-block; color: #ffffff; text-decoration: none; font-weight: 600;">
                                                    Manage Users
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div class="email-text-style">
                                    <p>
                                        If you have any questions or need a quick walkthrough, we're here to help, reach out to us at
                                        <a href="mailto:{{sparrowEmail}}" style="color: #316CF6;">{{sparrowEmail}}</a>
                                    </p>

                                    <p>
                                        Warm Regards,<br>
                                        The Sparrow Team
                                    </p>
                                </div>
                            </td>
                        </tr>
                    </table>
                </section>

                {{> footerV2}}

            </div>
        </section>
    </div>
</body>
</html>
