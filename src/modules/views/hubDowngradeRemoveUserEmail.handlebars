{{!< layoutName}} <!DOCTYPE html>
    <html lang="en">

  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Plan Downgraded User</title>

      <style>
          body {
              font-family: "Inter", sans-serif;
              box-sizing: border-box;
              padding: 0;
              margin: 0;
              transition: background-color 0.3s, color 0.3s;
          }

          .container {
              display: flex;
              justify-content: center;
              width: 100%;
              height: 100%;

          }

          .container-data {
              margin: auto;
              max-width: 570px;
              padding: 20px;
              transition: background-color 0.3s, color 0.3s;
          }

          .email-text-style {
              color: var(--email-text-color, #333);
              font-family: "Inter", sans-serif;
              font-size: 16px;
              font-style: normal;
              font-weight: 400;
              line-height: 21px;
          }
          .details-title {
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            font-weight: 400;            
            font-style: normal;          
            line-height: 1.43;           
            letter-spacing: 0;           
            text-align: left;
            margin-bottom: 10px;
        }

        .details-list {
            list-style-type: disc; 
            padding-left: 20px;
        }

        .details-list li {
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            font-weight: 400;            
            font-style: normal;          
            line-height: 1.43;           
            letter-spacing: 0;           
            text-align: left;
        }
        .status{
          font-family: 'Inter', sans-serif;
          font-weight: 700;           
          font-style: normal;          
          font-size: 16px;
          line-height: 1.5;            
          letter-spacing: 0;
        }
      </style>
  </head>

    <body>
     <div class="container">
         <section style="width: 100%;">
             <div class="container-data">

                 {{> headerV2}}
                 <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                     <tr>
                         <td align="center" valign="top">
                             <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                 <tr>
                                     <td align="center" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-headerv2.png" bgcolor="#4A90E2" style="background-position: center; background-repeat: no-repeat; background-size: cover;">
                                         <div style="padding: 40px 30px;">
                                             <h1 style="font-size: 20px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">Your {{hubName}} Hub Has Been Downgraded</h1><br>
                                         </div>
                                     </td>
                                 </tr>
                             </table>
                         </td>
                     </tr>
                 </table>
                 <section>
                     <!-- Welcome Box -->
                    <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                         <tr>
                             <td>
                                 <div class="email-text-style">
                                     <p>
                                         Hi {{userName}}, 👋
                                     </p>
                                     <p>
                                         This is a notification regarding your access to the <strong>{{hubName}}</strong> Hub. The Hub has been downgraded to our <strong>{{newPlanName}}</strong>, which has a limited number of seats for team members.
                                     </p>
                                     <p>
                                         As a result, your access to this Hub has been restricted, and you will no longer be able to view its workspaces or content.
                                     </p>
                                     <p>
                                        To regain access, please contact your Hub Owner. They can either upgrade the plan or assign an available active seat to you.
                                     </p>
                                 </div>
                             </td>
                         </tr>
                    </table>
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                         <tr>
                             <td>
                                 <div class="email-text-style">
                                     <p>
                                         If you have any questions or need a quick walkthrough, we’re here to help, reach out to us at
                                         <a href="mailto:contactus@sparrowapp.dev" style="color: #316CF6;">contactus@sparrowapp.dev</a>
                                     </p>
                                     <p>
                                         Warm Regards,<br>
                                         The Sparrow Team<br>
                                         <a href="https://sparrowapp.dev/" style="color: #316CF6;">https://sparrowapp.dev/</a>
                                     </p>
                                 </div>
                             </td>
                         </tr>
                     </table>
                 </section>
                 {{> footerV2}}
             </div>
         </section>
     </div>
  </body>
</html>