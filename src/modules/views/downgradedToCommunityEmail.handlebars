{{!< layoutName}} <!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Downgraded to Community Plan</title>

    <style>
        body {
            font-family: "Inter", sans-serif;
            box-sizing: border-box;
            padding: 0;
            margin: 0;
            transition: background-color 0.3s, color 0.3s;
        }

        .container {
            display: flex;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .container-data {
            margin: auto;
            max-width: 570px;
            padding: 20px;
            transition: background-color 0.3s, color 0.3s;
        }

        .email-text-style {
            color: var(--email-text-color, #333);
            font-family: "Inter", sans-serif;
            font-size: 16px;
            font-style: normal;
            font-weight: 400;
            line-height: 21px;
        }
    </style>
</head>

<body>
    <div class="container">
        <section style="width: 100%;">
            <div class="container-data">

                {{> headerV2}}
                
                <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                    <tr>
                        <td align="center" valign="top">
                            <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td align="center" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-headerv2.png" bgcolor="#4A90E2" style="background-position: center; background-repeat: no-repeat; background-size: cover;">
                                        <div style="padding: 40px 30px;">
                                            <h1 style="font-size: 28px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">Your Sparrow hub is being downgraded to the Community Plan</h1>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <div class="email-text-style" style="margin-bottom: 24px;">
                    Hi {{firstName}}, 👋
                </div>

                <div class="email-text-style" style="margin-bottom: 24px;">
                    The 3-day grace period for your subscription has ended. As a result, access to the {{hubName}} has been temporarily restricted for you and your team.
                </div>

                <div class="email-text-style" style="margin-bottom: 24px;">
                    To restore full access immediately and ensure your team can get back to work, please update your payment information.
                </div>

                <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 32px;">
                    <tr>
                        <td style="text-align: left;">
                            <a href="{{billingUrl}}" 
                               style="background: #1E90FF; color: white; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; display: inline-block;">
                                Upgrade Your Plan
                            </a>
                        </td>
                    </tr>
                </table>

                <div class="email-text-style" style="margin-bottom: 8px;">
                    If you have any questions or need a quick walkthrough, we're here to help, reach out to us at 
                    <a href="mailto:{{sparrowEmail}}" style="color: #1E90FF; text-decoration: none;">{{sparrowEmail}}</a>
                </div>

                <div class="email-text-style" style="margin-bottom: 8px;">
                    Warm Regards,
                </div>
                <div class="email-text-style">
                    The Sparrow Team
                </div>

                {{> footerV2}}

            </div>
        </section>
    </div>
</body>

</html>
