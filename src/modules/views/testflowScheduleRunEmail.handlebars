{{!< layoutName}} <!DOCTYPE html>
    <html lang="en">

  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Sparrow Test Report</title>


      <style>
          body {
              font-family: "Inter", sans-serif;
              box-sizing: border-box;
              padding: 0;
              margin: 0;
              transition: background-color 0.3s, color 0.3s;
          }

          .container {
              display: flex;
              justify-content: center;
              width: 100%;
              height: 100%;

          }

          .container-data {
              margin: auto;
              max-width: 570px;
              padding: 20px;
              transition: background-color 0.3s, color 0.3s;
          }

          .email-text-style {
              color: var(--email-text-color, #333);
              font-family: "Inter", sans-serif;
              font-size: 16px;
              font-style: normal;
              font-weight: 400;
              line-height: 21px;
          }
          .details-title {
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            font-weight: 400;            
            font-style: normal;          
            line-height: 1.43;           
            letter-spacing: 0;           
            text-align: left;
            margin-bottom: 10px;
        }

        .details-list {
            list-style-type: disc; 
            padding-left: 20px;
        }

        .details-list li {
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            font-weight: 400;            
            font-style: normal;          
            line-height: 1.43;           
            letter-spacing: 0;           
            text-align: left;
        }
        .status{
          font-family: 'Inter', sans-serif;
          font-weight: 700;           
          font-style: normal;          
          font-size: 16px;
          line-height: 1.5;            
          letter-spacing: 0;
        }
      </style>
  </head>

    <body>
     <div class="container">
         <section style="width: 100%;">
             <div class="container-data">

                 {{> headerV2}}
                 <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                     <tr>
                         <td align="center" valign="top">
                             <table width="100%" cellspacing="0" cellpadding="0" border="0">
                                 <tr>
                                     <td align="center" valign="middle" background="https://sparrowassets.blob.core.windows.net/emailtemplate/Sparrow-email-headerv2.png" bgcolor="#4A90E2" style="background-position: center; background-repeat: no-repeat; background-size: cover;">
                                         <div style="padding: 40px 30px;">
                                             <h1 style="font-size: 20px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">Sparrow Test Report</h1><br>
                                             <p style="font-size: 14px; font-weight: 400; color: #ffffff; margin: 0 0 0 0; line-height: 1.2; font-family: 'Inter', Arial, sans-serif;">Scheduled Run Completed</p>
                                         </div>
                                     </td>
                                 </tr>
                             </table>
                         </td>
                     </tr>
                 </table>
                 <section>
                     <!-- Welcome Box -->
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                         <tr>
                             <td>
                                 <div class="email-text-style">
                                     <p>
                                         Hi {{userName}}, 👋
                                     </p>
                                     <p>
                                         Your scheduled run for "{{scheduleName}}" completed at {{scheduleLastestRun}}. Here's the overview of the results:
                                     </p>
                                     <p>
                                         Run Result: 
                                        {{#if isSuccess}}
                                            ✅️ <span class="status" style=""> Success</span> (All Passed)
                                        {{else if isFailed}}
                                            ❌️ <span class="status" style=""> Failed</span>
                                        {{else if isPartial}}
                                            ⚠️ <span class="status" style=""> Partially Failed</span><span>({{scheduleRunPassedCount}}/{{scheduleRunTotalRequest}} Requests Failed)</span>
                                        {{/if}}
                                     </p>
                                 </div>
                             </td>
                         </tr>
                     </table>
                     <table style="margin-bottom: 20px;" class="email-text-style" width="100%" cellpadding="0" cellspacing="0" border="0">
                         <tr>
                             <td style="border-bottom:1px solid #b0b8c1" colspan="2">
                                 <h1 style="margin-top:0; margin-bottom: -6px; font-size: 20px; font-weight: 600;">Run Summary</h1>
                             </td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Total Requests</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">{{scheduleRunTotalRequest}}</td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Passed</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">{{scheduleRunPassedCount}}</td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Failed</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">{{scheduleRunFailedCount}}</td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Pass Rate</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">{{scheduleRunPassPercentage}}</td>
                         </tr>
                         <tr>
                             <td style="border-bottom:1px solid #e0e0e0;">Total Duration</td>
                             <td style="text-align:start; padding:12px 160px 12px 96px; border-bottom:1px solid #e0e0e0;">
                                 {{scheduleTotalTime}}
                             </td>
                         </tr>
                     </table>

                     <!-- Run Details -->
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 20px;">
                         <tr>
                             <td align="center" valign="middle">
                                  <tr>
                                    <td>
                                        <div style="padding: 20px 12px;">
                                            <h3 class="details-title">Run Details:</h3>
                                            <ul class="details-list">
                                            <li><strong>Schedule Name: </strong>{{scheduleName}}</li>
                                            <li><strong>Executed On: </strong>{{scheduleLastestRun}}</li>
                                            <li><strong>Environment: </strong>{{scheduleRunEnvName}}</li>
                                            </ul>
                                        </div>
                                    </td>
                                  </tr>
                                  <tr>
                                     <td>
                                        <div style="padding: 5px 12px 5px 12px;">
                                            <p style="font-size: 16px; margin: 0; line-height: 1.4; font-family: 'Inter', Arial, sans-serif; font-weight: 400; margin-bottom: 14px;">
                                            Click below to view full detailed report in Sparrow:
                                            </p>
                                            <div>
                                            <table cellspacing="0" cellpadding="0" border="0">
                                                <tr>
                                                <td style="border-radius: 6px; background-color: #316CF6; padding: 6px 12px; min-height: 36px; cursor:pointer;">
                                                    <a href="https://web.sparrowapp.dev/app/collections" class="email-text-style" style="display: inline-block; text-decoration: none;">
                                                    View Report
                                                    </a>
                                                </td>
                                                </tr>
                                            </table>
                                            </div>
                                        </div>
                                      </td>
                                  </tr>
                             </td>
                         </tr>
                     </table>
                     <table width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 30px;">
                         <tr>
                             <td>
                                 <div class="email-text-style">
                                     <p>
                                         If you have any questions or need a quick walkthrough, we’re here to help, reach out to us at
                                         <a href="mailto:contactus@sparrowapp.dev" style="color: #316CF6;">contactus@sparrowapp.dev</a>
                                     </p>
                                     <p>
                                         Warm Regards,<br>
                                         The Sparrow Team<br>
                                         <a href="https://sparrowapp.dev/" style="color: #316CF6;">https://sparrowapp.dev/</a>
                                     </p>
                                 </div>
                             </td>
                         </tr>
                     </table>


                 </section>
                 {{> footerV2}}
             </div>
         </section>
     </div>
  </body>
</html>